// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "darwin-arm64"] // Tento riadok sme pridali
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String

  books UsersBooks[]
  collections Collection[]
}


model Book {
  id Int @id @default(autoincrement())
  title String
  author String?
  fileKey String
  coverKey String?
  language String?
  isPublic Boolean @default(false)

  users UsersBooks[]
  genres GenresBooks[]
}

model UsersBooks {
  @@id([userId, bookId])

  userId Int
  userRelation User @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId Int
  bookRelation Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  visibility Visibility @default(PRIVATE)
  progress Int @default(0)
  currentLocation String?
  favourite Boolean @default(false)
  theme Themes @default(LIGHT)
  fontSize Int @default(16)

  customTitle String?
  customCoverKey String?

  addedAt DateTime @default(now())

  collections CollectionsBooks[]
}

model Collection {
  id Int @id @default(autoincrement())
  name String
  description String?

  userId Int
  userRelation User @relation(fields: [userId], references: [id], onDelete: Cascade)

  books CollectionsBooks[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
}

// Коллекция ссылается на UsersBooks, а не на Book напрямую: так в неё физически
// нельзя положить чужую книгу, а удаление книги из библиотеки убирает её из коллекций.
model CollectionsBooks {
  @@id([collectionId, userId, bookId])

  collectionId Int
  collectionRelation Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  userId Int
  bookId Int
  userBookRelation UsersBooks @relation(fields: [userId, bookId], references: [userId, bookId], onDelete: Cascade)

  addedAt DateTime @default(now())
}

model Genre {
  id Int @id @default(autoincrement())
  genre String @unique
  books GenresBooks[]
}

model GenresBooks {
  @@id([bookId, genreId])

  bookId Int
  bookRelation Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  genreId Int
  genreRelation Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum Themes {
  DARK
  LIGHT
  SEPIA
}