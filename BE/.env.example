# Postgres из docker-compose.yml
DATABASE_URL="postgresql://reader:reader_password@localhost:5434/reader_db?schema=public"

# Чем подписываются JWT и временные ссылки на файлы
JWT_SECRET="change-me"

# Где лежат .epub и обложки: local | supabase
# local  — папка BE/storage, файлы раздаёт сам API через /files/*
# supabase — нужны все три SUPABASE_* ниже
STORAGE_DRIVER="local"

# SUPABASE_URL="https://<project>.supabase.co"
# SUPABASE_SECRET_KEY="sb_secret_..."
# SUPABASE_BUCKET="reader-books"

# Необязательное
# PORT=3000
# PUBLIC_URL="http://localhost:3000"
# CORS_ORIGIN="http://localhost:5173"
